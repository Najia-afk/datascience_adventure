# DataScience Adventure - Environment Variables
# Copy this file to .env and fill in your values

# ===== Google OAuth Configuration =====
# Get these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# ===== Allowed Users =====
# Comma-separated list of email addresses that can access the dashboard
# Leave empty to allow all authenticated Google users
ALLOWED_EMAILS=user1@example.com,user2@example.com

# ===== Security =====
# Flask session secret - generate a random string for production
SECRET_KEY=change-this-in-production-use-random-string

# ===== Optional: Override Redirect URI =====
# Usually auto-detected, only set if needed
# GOOGLE_REDIRECT_URI=http://localhost:8080/login
