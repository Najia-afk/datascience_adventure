[Unit]
Description=HTMX Website using Gunicorn and Flask
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/htmx_website
# ExecStart will be updated by deploy.sh based on detected gunicorn path and WSGI entry
ExecStart=/usr/bin/gunicorn --workers 5 --bind 127.0.0.1:8000 --timeout 120 wsgi:app
Restart=always
Environment="PYTHONUNBUFFERED=1"
# Set reasonable resource limits
LimitNOFILE=4096
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
